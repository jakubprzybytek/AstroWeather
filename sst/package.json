{
  "name": "astroweather-sst",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "sst dev",
    "deploy": "sst deploy",
    "remove": "sst remove",
    "test": "npm run test:unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "sst shell -- vitest run --project integration",
    "test:clearoutside": "RUN_LIVE_SCRAPE=1 sst shell -- vitest run --project integration --disableConsoleIntercept packages/functions/tests/integration/clearoutside.integration.test.ts",
    "test:web": "vitest run --project web",
    "test:all": "vitest run"
  },
  "devDependencies": {
    "@types/suncalc": "^1.9.2",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "node-html-parser": "^9.0.4",
    "sst": "^4.7.9",
    "suncalc": "^1.9.0"
  }
}
