    "version": "0.2.0",
    "configurations": [
        {
            "name": "HostController Debug",
            "type": "stlinkgdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "runEntry": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/build/Debug-HostController/HostControllerA.elf"
                }
            ],
            "verbose": false
        },
        {
            "name": "HostController Release",
            "type": "stlinkgdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "runEntry": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/build/Release-HostController/HostControllerA.elf"
                }
            ],
            "verbose": false
        }
    ]
}